#!/usr/bin/env php
<?php

declare(strict_types=1);

use Hirtz\Skeleton\Console\Application;

$env = getenv('YII_ENV') ?: 'prod';

defined('YII_ENV') or define('YII_ENV', $env);
defined('YII_DEBUG') or define('YII_DEBUG', $env !== 'prod');

require __DIR__ . '/vendor/autoload.php';
require __DIR__ . '/vendor/yiisoft/yii2/Yii.php';

// named here, not taken from the working directory, which is wherever a cron job or deploy step runs from
exit((int)(new Application(['basePath' => __DIR__, ...require __DIR__ . "/config/$env.php"]))->run());
