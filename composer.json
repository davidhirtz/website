{
  "name": "davidhirtz/website",
  "description": "Yii2 CMS Template",
  "homepage": "https://github.com/davidhirtz/website",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.3",
    "davidhirtz/yii2-anakin": "^3.1.1",
    "davidhirtz/yii2-cms": "^3.15",
    "davidhirtz/yii2-skeleton": "^3.19",
    "davidhirtz/yii2-vite": "^3.4"
  },
  "require-dev": {
    "davidhirtz/yii2-dev": "^3.0.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app",
      "Installer\\": "installer"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true
  },
  "scripts": {
    "check": "vendor/bin/check",
    "cs-check": "php-cs-fixer check --diff",
    "cs-fix": "php-cs-fixer fix",
    "install-hooks": "git config core.hooksPath .githooks",
    "phpstan": "phpstan --memory-limit=1G",
    "post-create-project-cmd": [
      "Installer\\Installer::postCreateProject"
    ],
    "post-install-cmd": [
      "yii\\composer\\Installer::postInstall"
    ],
    "rector": "rector",
    "test": "phpunit"
  },
  "scripts-descriptions": {
    "check": "Runs the code style, static analysis and test checks a push is gated on",
    "install-hooks": "Points git at the committed .githooks directory, enabling the pre-push check"
  },
  "extra": {
    "yii\\composer\\Installer::postInstall": {
      "setPermission": [
        {
          "runtime": "0777",
          "web/assets": "0777",
          "web/uploads": "0777",
          "yii": "0755"
        }
      ]
    }
  }
}
