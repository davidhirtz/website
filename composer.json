{
  "name": "davidhirtz/yii2-cms-template",
  "description": "Yii2 CMS Template",
  "homepage": "https://www.github.com/davidhirtz/yii2-cms-template",
  "type": "project",
  "require": {
    "php": "^8.3",
    "davidhirtz/yii2-anakin": "^2.1",
    "davidhirtz/yii2-cms": "^2.4",
    "davidhirtz/yii2-vite": "^0.5"
  },
  "require-dev": {
    "rector/rector": "^2.0",
    "symfony/var-dumper": "^6.3",
    "symplify/easy-coding-standard": "^12.0",
    "yiisoft/yii2-debug": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "platform": {
        "php": "8.3"
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "post-install-cmd": [
      "yii\\composer\\Installer::postInstall",
      "php yii migrate --interactive=0"
    ],
    "rector": "rector"
  },
  "extra": {
    "yii\\composer\\Installer::postInstall": {
      "setPermission": [
        {
          "runtime": "0777",
          "web/assets": "0777",
          "web/uploads": "0777",
          "yii": "0755"
        }
      ]
    }
  }
}
