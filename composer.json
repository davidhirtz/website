{
  "name": "davidhirtz/yii2-cms-template",
  "description": "Yii2 CMS Template",
  "homepage": "https://www.github.com/davidhirtz/yii2-cms-template",
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.3",
    "davidhirtz/yii2-anakin": "main-dev",
    "davidhirtz/yii2-cms": "main-dev",
    "davidhirtz/yii2-vite": "^0.5"
  },
  "require-dev": {
    "components/jquery": "^3.7",
    "friendsofphp/php-cs-fixer": "^3.91",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "rector/rector": "^2.2",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4",
    "symfony/var-dumper": "^7.4",
    "yiisoft/yii2-debug": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "platform": {
      "php": "8.3"
    },
    "sort-packages": true
  },
  "scripts": {
    "check": "bin/check",
    "cs-check": "php-cs-fixer check --diff",
    "cs-fix": "php-cs-fixer fix",
    "install-hooks": "git config core.hooksPath .githooks",
    "phpstan": "phpstan --memory-limit=1G",
    "post-install-cmd": [
      "yii\\composer\\Installer::postInstall"
    ],
    "rector": "rector",
    "test": "phpunit"
  },
  "scripts-descriptions": {
    "check": "Runs the code style, static analysis and test checks a push is gated on",
    "install-hooks": "Points git at the committed .githooks directory, enabling the pre-push check"
  },
  "extra": {
    "yii\\composer\\Installer::postInstall": {
      "setPermission": [
        {
          "runtime": "0777",
          "web/assets": "0777",
          "web/uploads": "0777",
          "yii": "0755"
        }
      ]
    }
  }
}
