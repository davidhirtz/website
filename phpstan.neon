# The level, the dynamic constants and the skeleton's `Yii.php` come from `davidhirtz/yii2-dev`; the paths to
# analyse are what differs between installations.

includes:
    - vendor/davidhirtz/yii2-dev/config/phpstan-app.neon

parameters:
    paths:
        - app
        - config
        - resources/views
        - tests
