parameters:
    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    level: 7

    paths:
        - app
        - config
        - resources/views
        - tests

    scanFiles:
        - vendor/davidhirtz/yii2-skeleton/Yii.php
        - vendor/yiisoft/yii2/BaseYii.php

    stubFiles:
        - vendor/davidhirtz/yii2-skeleton/stubs/yii.stub

    earlyTerminatingMethodCalls:
        yii\base\Application:
            - end
        yii\base\ErrorHandler:
            - convertExceptionToError
