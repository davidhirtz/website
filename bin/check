#!/bin/sh

# The three gates a change has to pass — code style, static analysis and the test suite — run against the
# working tree. The pre-push hook and `composer check` are both this file, so what is run by hand and what is
# run before a push cannot drift apart.
#
# A push to a branch with a deploy path deploys it (`.github/workflows/deploy.yml`), and nothing on the way
# there runs these checks, so this is the only gate between a broken commit and the server.
#
# The style fixer runs first because it is the cheapest of the three and the one most easily forgotten, so a
# missing `composer cs-fix` is answered in seconds rather than after the suite. All three have to pass either
# way; only how soon you hear about it changes.
#
# `check` never rewrites a file: this runs against a commit that is already made, and a fixer that edited the
# tree here would leave the correction behind, unpushed, in exactly the state the check was meant to prevent.

set -e

cd "$(dirname "$0")/.."

export XDEBUG_MODE=off

echo "==> Code style"
vendor/bin/php-cs-fixer check --diff

echo "==> Static analysis"
php -d memory_limit=1G vendor/bin/phpstan

# The test database persists between runs, so a migration added since the last one would otherwise surface as
# an unexplained failure in the suite below. Migrating is idempotent and prints nothing when there is nothing
# to apply. `config/test.php` falls back to the gitignored `config/db.php`, so nothing needs to be exported.
echo "==> Test database"
YII_ENV=test ./yii migrate --interactive=0 --skip-backup

echo "==> Tests"
php -d memory_limit=1G vendor/bin/phpunit
